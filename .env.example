# ---------------------------------------------------------------------------
# Nova Teknik OBS · Ortam yapılandırması
# ---------------------------------------------------------------------------
# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
# Supabase anahtarları boşsa giriş yapılabilmesi için demo modunun açıkça
# etkinleştirilmesi gerekir (VITE_ALLOW_DEMO=true). Demo girişi üretim
# derlemesinde her zaman kapalıdır ve demo oturumu yalnızca bellekte tutulur.
#
# Supabase değerleri: Dashboard → Project Settings → API
# ÖNEMLİ: Yalnızca publishable/public anahtarını kullanın. service_role veya
# sb_secret_... anahtarlarını asla VITE_* değişkenlerine koymayın; tarayıcı
# paketine dahil olur.
# ---------------------------------------------------------------------------

# --- Supabase (opsiyonel) --------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Birincil: yeni "Publishable key" değeri (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy (opsiyonel): eski "anon" JWT anahtarı. Publishable key tanımlıysa
# yok sayılır; yalnızca mevcut kurulumların çalışmaya devam etmesi içindir.
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Demo girişi (yalnızca yerel geliştirme) --------------------------------
# Varsayılan olarak kapalıdır. Demo girişini açmak için "true" yapın.
# Supabase yapılandırıldığında veya üretim derlemesinde bu ayar yok sayılır.
VITE_ALLOW_DEMO=false

# --- Veri arka ucu (opsiyonel) ---------------------------------------------
# local | supabase | aws — boş bırakılırsa Supabase anahtarlarına göre seçilir.
VITE_DATA_BACKEND=
# AWS hedefi (yalnızca VITE_DATA_BACKEND=aws iken kullanılır)
VITE_API_BASE_URL=
VITE_AWS_REGION=eu-central-1

# --- QR yoklama (opsiyonel) ------------------------------------------------
# QR kodun kaç saniyede bir yenileneceği (10–120, varsayılan 20).
VITE_ATTENDANCE_ROTATION_SECONDS=20
