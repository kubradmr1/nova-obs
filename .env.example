# ---------------------------------------------------------------------------
# Nova Teknik OBS · Ortam yapılandırması
# ---------------------------------------------------------------------------
# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
# Supabase anahtarları boş bırakılırsa uygulama otomatik olarak demo modunda
# çalışır (şifreli demo girişi + localStorage mesajlaşma ve yoklama).
#
# Supabase değerleri: Dashboard → Project Settings → API
# ÖNEMLİ: Yalnızca "anon" (public) anahtarını kullanın. service_role anahtarını
# asla VITE_* değişkenlerine koymayın; tarayıcı paketine dahil olur.
# ---------------------------------------------------------------------------

# --- Supabase (opsiyonel) --------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Veri arka ucu (opsiyonel) ---------------------------------------------
# local | supabase | aws — boş bırakılırsa Supabase anahtarlarına göre seçilir.
VITE_DATA_BACKEND=
# AWS hedefi (yalnızca VITE_DATA_BACKEND=aws iken kullanılır)
VITE_API_BASE_URL=
VITE_AWS_REGION=eu-central-1

# --- QR yoklama (opsiyonel) ------------------------------------------------
# QR kodun kaç saniyede bir yenileneceği (10–120, varsayılan 20).
VITE_ATTENDANCE_ROTATION_SECONDS=20
